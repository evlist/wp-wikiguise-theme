{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Wikiguise",
	"settings": {
		"appearanceTools": true,
		"layout": { "contentSize": "52rem", "wideSize": "90rem" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#ffffff" },
				{ "slug": "contrast", "name": "Contrast", "color": "#202122" },
				{ "slug": "muted", "name": "Muted", "color": "#54595d" },
				{ "slug": "rule", "name": "Rule", "color": "#c8ccd1" },
				{ "slug": "panel", "name": "Panel", "color": "#f8f9fa" },
				{ "slug": "link", "name": "Link", "color": "#0645ad" },
				{ "slug": "missing", "name": "Missing page", "color": "#ba0000" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{ "slug": "sans", "name": "Sans", "fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif" },
				{ "slug": "serif", "name": "Serif", "fontFamily": "\"Linux Libertine\", \"Libertinus Serif\", Georgia, \"Times New Roman\", serif" }
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "0.9375rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.5rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
				{ "slug": "heading-3", "name": "Heading 3", "size": "1.25rem", "fluid": false }
			]
		},
		"spacing": {
			"spacingSizes": [
				{ "slug": "20", "name": "1", "size": "0.5rem" },
				{ "slug": "30", "name": "2", "size": "1rem" },
				{ "slug": "40", "name": "3", "size": "1.5rem" },
				{ "slug": "50", "name": "4", "size": "2rem" }
			]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": { "blockGap": "0.75rem" },
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--link)" },
				"typography": { "textDecoration": "none" },
				":hover": { "typography": { "textDecoration": "underline" } },
				":focus-visible": { "typography": { "textDecoration": "underline" } }
			},
			"h1": { "typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontSize": "var(--wp--preset--font-size--x-large)", "fontWeight": "400", "lineHeight": "1.2" } },
			"h2": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontSize": "var(--wp--preset--font-size--large)", "fontWeight": "400", "lineHeight": "1.3" },
				"border": { "bottom": { "color": "var(--wp--preset--color--rule)", "style": "solid", "width": "1px" } },
				"spacing": { "margin": { "top": "1.75rem", "bottom": "0.625rem" } }
			},
			"h3": { "typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontSize": "var(--wp--preset--font-size--heading-3)", "fontWeight": "400" }, "spacing": { "margin": { "top": "1.25rem" } } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "700" } }
		},
		"blocks": {
			"core/post-title": {
				"border": { "bottom": { "color": "var(--wp--preset--color--rule)", "style": "solid", "width": "1px" } },
				"spacing": { "margin": { "bottom": "0" } }
			},
			"core/table": { "css": "& table{border-collapse:collapse}& th,& td{border:1px solid var(--wp--preset--color--rule);padding:.25rem .5rem}" },
			"core/footnotes": { "typography": { "fontSize": "var(--wp--preset--font-size--small)" } }
		},
		"css": "main :where(table){display:block;max-width:100%;overflow-x:auto}main img{max-width:100%;height:auto}"
	},
	"customTemplates": [
		{ "name": "wiki-biographie", "title": "Biographie", "postTypes": [ "page" ] },
		{ "name": "wiki-encyclopedie", "title": "Encyclopédie", "postTypes": [ "page" ] }
	],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "menu", "title": "Menu column", "area": "uncategorized" },
		{ "name": "tools", "title": "Tools column", "area": "uncategorized" }
	]
}
